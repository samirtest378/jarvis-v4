# Language model provider. The sale-ready default is OpenAI cloud; no local
# language model is required.
JARVIS_LLM_PROVIDER=openai

# Add only the keys you use. The desktop app stores these with operating-system
# encryption; environment variables remain a fallback when no value was saved in the app.
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# MOONSHOT_API_KEY=your-moonshot-api-key-here
# KIMI_API_KEY=your-kimi-api-key-here  # optional alias
# DASHSCOPE_API_KEY=your-dashscope-api-key-here
# QWEN_API_KEY=your-qwen-api-key-here  # optional alias
# GEMINI_API_KEY=your-gemini-api-key-here
# GOOGLE_API_KEY=your-gemini-api-key-here  # optional alias
# XAI_API_KEY=your-xai-api-key-here
# GROK_API_KEY=your-xai-api-key-here  # optional alias
# OPENAI_COMPATIBLE_API_KEY=

# Provider defaults:
# OpenAI: https://api.openai.com/v1, chat gpt-5.4-nano,
# research gpt-5.4-nano
# Kimi Global: https://api.moonshot.ai/v1, chat kimi-k2.6, research kimi-k3
# Qwen International: https://dashscope-intl.aliyuncs.com/compatible-mode/v1, model qwen3.7-plus
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai, model gemini-3.6-flash
# Grok: https://api.x.ai/v1, model grok-4.3
# Custom cloud endpoints must use HTTPS.
# JARVIS_LLM_BASE_URL=https://provider.example/v1
# JARVIS_MODEL=provider-model-name
# JARVIS_RESEARCH_MODEL=provider-research-model-name

# Optional speech service
# FISH_API_KEY=your-fish-audio-api-key-here

# Optional Google Desktop OAuth connection for read-only Gmail metadata and
# Calendar events. Public distribution requires the seller's verified OAuth
# client; never publish a customer's refresh token.
# GOOGLE_OAUTH_CLIENT_ID=123-example.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Optional: Fish Audio voice reference you created or may use commercially
# FISH_VOICE_ID=your-licensed-fish-voice-id

# Voice output defaults to the bundled selected German/English voice: local,
# CPU-only, consistent across Windows devices, and free after installation.
# Values: system | auto | fish | local | openai | off
JARVIS_TTS_PROVIDER=local
# JARVIS_SYSTEM_VOICE=Auto
JARVIS_SPEECH_LANGUAGE=auto
# Fresh installs begin listening only after the one-time microphone permission
# step. Set 0 to keep the microphone off until its main-screen button is used.
JARVIS_WAKE_ENABLED=1
# JARVIS_SYSTEM_SPEECH_RATE=165

# Automatic speech recognition uses bundled CPU-only Q8 Whisper first, keeping
# German/English microphone audio on this computer. A configured cloud provider
# is used only as a fallback when local recognition is unavailable.
# Values: auto | openai | fish | local | off
JARVIS_STT_PROVIDER=auto
# JARVIS_STT_MODEL=gpt-4o-mini-transcribe
# Frozen Chatterbox packs can take a few minutes on their first start.
# Values are bounded to 5..900 seconds by the backend.
# JARVIS_LOCAL_VOICE_START_TIMEOUT=300
# JARVIS_LOCAL_VOICE_SYNTH_TIMEOUT=180

# Optional: Your name (JARVIS will address you by name)
# USER_NAME=Tony

# Optional: Specific Apple Calendar accounts to read (comma-separated emails)
# If not set, JARVIS reads ALL calendars from Apple Calendar
# CALENDAR_ACCOUNTS=you@gmail.com,work@company.com

# Optional opt-in weather context (no request is made unless both are set)
# JARVIS_WEATHER_LATITUDE=41.9981
# JARVIS_WEATHER_LONGITUDE=21.4254
# JARVIS_WEATHER_LOCATION=Skopje

# Security: Auth token for API access. Auto-generated on first run if not set.
# Pass as 'Authorization: Bearer <token>' header or '?token=<token>' query param.
# JARVIS_AUTH_TOKEN=
# JARVIS_ACCESS_LOG=false

# Advanced: writable locations used by the packaged desktop app
# JARVIS_CONFIG_DIR=/path/to/config
# JARVIS_DATA_DIR=/path/to/data
# Optional advanced context. Disabled by default because visible window titles
# can contain private information. Explicit "look at my screen" requests work
# without enabling this background mode.
JARVIS_BACKGROUND_SCREEN_CONTEXT=0
